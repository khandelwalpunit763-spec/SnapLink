# ──────────────────────────────────────────────────────────────
# SnapLink environment variables
# Copy to .env.local for local dev; set in Vercel → Settings → Environment Variables for production.
# ──────────────────────────────────────────────────────────────

# ---- Site ----------------------------------------------------
# Canonical URL of your deployment (used for SEO, sitemap, robots, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Google AdSense (optional) --------------------------------
# Leave empty to render labelled placeholder boxes.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_RESULTS=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# ---- Download API ----------------------------------------------
# auto      → cobalt (free) → RapidAPI (if key set) → self API (if URL set) → demo
# cobalt    → force cobalt instances only
# self      → force self-hosted API
# rapidapi  → force RapidAPI
# demo      → metadata only (oEmbed), no download links
API_PROVIDER=auto

# Option A: cobalt-compatible instances (default — works on Vercel, no signup)
# Comma-separated API instances, tried in order. Find more at
# https://instances.cobalt.best (pick ones marked as not requiring an API key).
COBALT_INSTANCES=
# If your instance requires an API key, put it here:
COBALT_API_KEY=

# Option B: RapidAPI (recommended for Instagram/Facebook/X)
RAPIDAPI_KEY=
# Per-platform host/path overrides if your RapidAPI product differs
# (defaults live in src/lib/api/config.ts):
RAPIDAPI_YT_HOST=
RAPIDAPI_YT_PATH=
RAPIDAPI_IG_HOST=
RAPIDAPI_IG_PATH=
RAPIDAPI_FB_HOST=
RAPIDAPI_FB_PATH=
RAPIDAPI_TW_HOST=
RAPIDAPI_TW_PATH=

# Option C: self-hosted yt-dlp server (see /server + Dockerfile — deploy on Railway/Render)
# e.g. DOWNLOADER_API_URL=https://snaplink-api.your-domain.com
DOWNLOADER_API_URL=
